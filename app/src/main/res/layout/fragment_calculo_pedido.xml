<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D0D0D0"
    tools:context=".CalculoPedidoFragment">

    <!-- Top Left Round Blue Hamburger Menu Button (Matching Capture 1) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btn_top_left_menu"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="#4A90E2"
        app:cardCornerRadius="22dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="Menú de opciones"
            android:src="@drawable/ic_menu_hamburger"
            app:tint="@color/white" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Top Right Menu Icon Button -->
    <ImageView
        android:id="@+id/btn_header_menu"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="Opciones del pedido"
        android:focusable="true"
        android:padding="6dp"
        android:src="@drawable/ic_more_vert"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#333333" />

    <!-- Top Right: Client Name Header & param. comprobar Checkbox -->
    <TextView
        android:id="@+id/tv_header_cliente_nombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:textColor="#333333"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@id/btn_header_menu"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Aleksander White : S1" />

    <CheckBox
        android:id="@+id/cb_param_comprobar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="4dp"
        android:checked="true"
        android:text="param. comprobar"
        android:textColor="#333333"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@id/btn_header_menu"
        app:layout_constraintTop_toBottomOf="@id/tv_header_cliente_nombre" />

    <!-- Center Drawing Canvas Area with WindowPreviewView -->
    <FrameLayout
        android:id="@+id/canvas_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:background="#D0D0D0"
        app:layout_constraintBottom_toTopOf="@id/card_bottom_matrix"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cb_param_comprobar">

        <com.example.vineuro_pvc.views.WindowPreviewView
            android:id="@+id/wpv_main_canvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="16dp" />

        <!-- Delete Icon Button (Bottom Right of Canvas) -->
        <ImageView
            android:id="@+id/btn_delete_item"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:background="#E8E8E8"
            android:contentDescription="Eliminar elemento"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="#888888" />

    </FrameLayout>

    <!-- "param. comprobar": opciones del compás de la ventana activa (arriba a la derecha, flotando semitransparente sobre el dibujo) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_parametros"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:clickable="false"
        android:focusable="false"
        android:translationZ="4dp"
        android:visibility="gone"
        app:cardBackgroundColor="#8CFFFFFF"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cb_param_comprobar"
        app:strokeColor="#9961B813"
        app:strokeWidth="1dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tv_parametros_titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="280dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Parámetros"
                android:textColor="#61B813"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_parametros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:maxWidth="280dp"
                android:maxLines="12"
                android:textColor="#1F2937"
                android:textSize="11sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Matrix Table Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_bottom_matrix"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="horizontal">

            <TableLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E5E5E5"
                android:stretchColumns="*">

                <!-- Header Row -->
                <TableRow
                    android:background="#DDDDDD"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp">

                    <TextView
                        android:layout_width="110dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="@string/header_parte"
                        android:textColor="#333333"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="75dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/header_zona"
                        android:textColor="#333333"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="75dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/header_marcos"
                        android:textColor="#333333"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="75dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/header_impostas"
                        android:textColor="#333333"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="85dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/header_glaz_beads"
                        android:textColor="#333333"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="70dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/header_caucho"
                        android:textColor="#333333"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="65dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/header_hojas"
                        android:textColor="#333333"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="110dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/header_hojas_puerta"
                        android:textColor="#333333"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="70dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/header_total"
                        android:textColor="#D32F2F"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </TableRow>

                <!-- Row 1: ventana -->
                <TableRow
                    android:background="#EEEEEE"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="@string/row_ventana"
                        android:textColor="#333333"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/cell_v_zona"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        tools:text="2.70 m2" />

                    <TextView
                        android:id="@+id/cell_v_marcos"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        tools:text="6.60 m" />

                    <TextView
                        android:id="@+id/cell_v_impostas"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        tools:text="2.81 m" />

                    <TextView
                        android:id="@+id/cell_v_glaz"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        tools:text="11.62 m" />

                    <TextView
                        android:id="@+id/cell_v_caucho"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        tools:text="11.62 m" />

                    <TextView
                        android:id="@+id/cell_v_hojas"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        tools:text="-" />

                    <TextView
                        android:id="@+id/cell_v_hojas_p"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        tools:text="-" />

                    <TextView
                        android:id="@+id/cell_v_total"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#1976D2"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="0 S/" />
                </TableRow>

                <!-- Row 2: precio (Blue Text) -->
                <TableRow
                    android:background="#E0E0E0"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="@string/row_precio"
                        android:textColor="#1976D2"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/cell_p_zona"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#1976D2"
                        android:textSize="12sp"
                        tools:text="-" />

                    <TextView
                        android:id="@+id/cell_p_marcos"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#1976D2"
                        android:textSize="12sp"
                        tools:text="-" />

                    <TextView
                        android:id="@+id/cell_p_impostas"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#1976D2"
                        android:textSize="12sp"
                        tools:text="-" />

                    <TextView
                        android:id="@+id/cell_p_glaz"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#1976D2"
                        android:textSize="12sp"
                        tools:text="-" />

                    <TextView
                        android:id="@+id/cell_p_caucho"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#1976D2"
                        android:textSize="12sp"
                        tools:text="-" />

                    <TextView
                        android:id="@+id/cell_p_hojas"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#1976D2"
                        android:textSize="12sp"
                        tools:text="-" />

                    <TextView
                        android:id="@+id/cell_p_hojas_p"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#1976D2"
                        android:textSize="12sp"
                        tools:text="-" />

                    <TextView
                        android:id="@+id/cell_p_total"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#1976D2"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="0.00 (-0%)" />
                </TableRow>

                <!-- Row 3: todas las ventanas -->
                <TableRow
                    android:background="#EEEEEE"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="@string/row_todas_ventanas"
                        android:textColor="#333333"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/cell_tv_zona"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        tools:text="2.70 m2" />

                    <TextView
                        android:id="@+id/cell_tv_marcos"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        tools:text="6.60 m" />

                    <TextView
                        android:id="@+id/cell_tv_impostas"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        tools:text="2.81 m" />

                    <TextView
                        android:id="@+id/cell_tv_glaz"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        tools:text="11.62 m" />

                    <TextView
                        android:id="@+id/cell_tv_caucho"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        tools:text="11.62 m" />

                    <TextView
                        android:id="@+id/cell_tv_hojas"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        tools:text="-" />

                    <TextView
                        android:id="@+id/cell_tv_hojas_p"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        tools:text="-" />

                    <TextView
                        android:id="@+id/cell_tv_total"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#1976D2"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="0 S/" />
                </TableRow>

                <!-- Row 4: costo (Red Text) -->
                <TableRow
                    android:background="#E0E0E0"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="@string/row_costo"
                        android:textColor="#D32F2F"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/cell_c_zona"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#D32F2F"
                        android:textSize="12sp"
                        tools:text="-" />

                    <TextView
                        android:id="@+id/cell_c_marcos"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#D32F2F"
                        android:textSize="12sp"
                        tools:text="-" />

                    <TextView
                        android:id="@+id/cell_c_impostas"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#D32F2F"
                        android:textSize="12sp"
                        tools:text="-" />

                    <TextView
                        android:id="@+id/cell_c_glaz"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#D32F2F"
                        android:textSize="12sp"
                        tools:text="-" />

                    <TextView
                        android:id="@+id/cell_c_caucho"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#D32F2F"
                        android:textSize="12sp"
                        tools:text="-" />

                    <TextView
                        android:id="@+id/cell_c_hojas"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#D32F2F"
                        android:textSize="12sp"
                        tools:text="-" />

                    <TextView
                        android:id="@+id/cell_c_hojas_p"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#D32F2F"
                        android:textSize="12sp"
                        tools:text="-" />

                    <TextView
                        android:id="@+id/cell_c_total"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="#D32F2F"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="0.00 (-0%)" />
                </TableRow>

            </TableLayout>

        </HorizontalScrollView>

    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Blue Action Bar with Horizontal Scroll for Window Tabs -->
    <FrameLayout
        android:id="@+id/bottom_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#42A5F5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="56dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/container_window_tabs"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />

        </HorizontalScrollView>

    </FrameLayout>

    <!-- Square Action Plus Button (+) at Bottom Left -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btn_add_item"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="#52A2FA"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:contentDescription="Agregar elemento"
            android:src="@drawable/ic_menu_add"
            app:tint="@color/white" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Green Square Action Compass Button (Herramientas Técnicas) at Bottom Right -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btn_compass"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="#8BC34A"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:contentDescription="Herramientas de dibujo técnico"
            android:src="@drawable/ic_compass"
            app:tint="@color/white" />

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
