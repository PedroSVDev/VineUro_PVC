<?xml version="1.0" encoding="utf-8"?>
<!-- Diálogo del paño en DOS COLUMNAS:
     izquierda = impostas (cuadrícula compacta) + paneles sándwich / puerta / mosquitero
     derecha   = apertura.
     El alto y el número de columnas se ajustan en código según la pantalla (teléfono o tablet). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#CCCCCC"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/cuerpo_dos_columnas"
        android:layout_width="match_parent"
        android:layout_height="440dp"
        android:orientation="horizontal">

        <!-- COLUMNA IZQUIERDA: impostas -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.45"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:background="#42A5F5"
                android:gravity="center"
                android:text="impostas"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_impostas_layouts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="3"
                        tools:listitem="@layout/item_window_config" />

                    <!-- Opciones del paño: tarjetas blancas con ícono de color -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:paddingStart="4dp"
                        android:text="OPCIONES DEL PAÑO"
                        android:textColor="#1E3A5F"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/contenedor_opciones_pano"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="6dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="1dp"
                            app:strokeColor="#B0BEC5"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:background="@drawable/bg_icono_opcion"
                                        android:backgroundTint="#8D6E63"
                                        android:contentDescription="paneles sándwich"
                                        android:padding="5dp"
                                        android:src="@drawable/ic_sandwich_panel"
                                        app:tint="#FFFFFF" />

                                    <CheckBox
                                        android:id="@+id/cb_sandwich_panels"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:layout_weight="1"
                                        android:buttonTint="@color/brand_dark"
                                        android:minHeight="40dp"
                                        android:text="paneles sándwich"
                                        android:textColor="#1E3A5F"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <!-- Una casilla por cada parte de la imposta (la llena el código) -->
                                <LinearLayout
                                    android:id="@+id/contenedor_partes_sandwich"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingStart="34dp"
                                    android:paddingBottom="4dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="1dp"
                            app:strokeColor="#B0BEC5"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:background="@drawable/bg_icono_opcion"
                                        android:backgroundTint="#5C6BC0"
                                        android:contentDescription="puerta"
                                        android:padding="5dp"
                                        android:src="@drawable/ic_door"
                                        app:tint="#FFFFFF" />

                                    <CheckBox
                                        android:id="@+id/cb_puerta"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:layout_weight="1"
                                        android:buttonTint="@color/brand_dark"
                                        android:minHeight="40dp"
                                        android:text="puerta"
                                        android:textColor="#1E3A5F"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="1dp"
                            app:strokeColor="#B0BEC5"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:background="@drawable/bg_icono_opcion"
                                        android:backgroundTint="#26A69A"
                                        android:contentDescription="mosquitero"
                                        android:padding="5dp"
                                        android:src="@drawable/ic_mosquito_net"
                                        app:tint="#FFFFFF" />

                                    <CheckBox
                                        android:id="@+id/cb_mosq_net"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:layout_weight="1"
                                        android:buttonTint="@color/brand_dark"
                                        android:minHeight="40dp"
                                        android:text="mosquitero"
                                        android:textColor="#1E3A5F"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- Separador -->
        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="#999999" />

        <!-- COLUMNA DERECHA: apertura -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.55"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:background="#42A5F5"
                android:gravity="center"
                android:text="apertura"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_apertura_mechanisms"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="4dp"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="3"
                tools:listitem="@layout/item_window_config" />
        </LinearLayout>
    </LinearLayout>

    <!-- Botones: NO (azul) / SÍ (verde) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_no"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.45"
            android:backgroundTint="#42A5F5"
            android:text="NO"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_si"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.55"
            android:backgroundTint="#9CCC65"
            android:text="SÍ"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="0dp" />
    </LinearLayout>

</LinearLayout>
