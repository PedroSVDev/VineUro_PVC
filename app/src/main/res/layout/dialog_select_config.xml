<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CCCCCC"
    android:orientation="vertical">

    <!-- Top Two Column Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- LEFT PANEL: impostas -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.45"
            android:background="#CCCCCC"
            android:orientation="vertical">

            <!-- Header: impostas -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="#42A5F5"
                android:gravity="center"
                android:text="impostas"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fadeScrollbars="false"
                android:fillViewport="true"
                android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Layout Grid Selection (2 Columns) -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_impostas_layouts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="2"
                        tools:listitem="@layout/item_icono_config" />

                    <!-- Toggle Options with Icons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                        <!-- Option 1: Sandwich Panels -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginEnd="6dp"
                                android:contentDescription="sandwich panels"
                                android:src="@drawable/ic_sandwich_panel"
                                app:tint="#444444" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="sandwich panels"
                                android:textColor="#222222"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Un sándwich por vidrio (1, 2 o 3 según la imposta interior) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <CheckBox android:textColor="#212121"
                                android:id="@+id/cb_sandwich_panels"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <CheckBox android:textColor="#212121"
                                android:id="@+id/cb_sandwich2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:visibility="gone" />

                            <CheckBox android:textColor="#212121"
                                android:id="@+id/cb_sandwich3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:visibility="gone" />

                            <CheckBox android:textColor="#212121"
                                android:id="@+id/cb_sandwich4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:visibility="gone" />

                            <CheckBox android:textColor="#212121"
                                android:id="@+id/cb_sandwich5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:visibility="gone" />

                            <CheckBox android:textColor="#212121"
                                android:id="@+id/cb_sandwich6"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:visibility="gone" />

                            <CheckBox android:textColor="#212121"
                                android:id="@+id/cb_sandwich7"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:visibility="gone" />

                            <CheckBox android:textColor="#212121"
                                android:id="@+id/cb_sandwich8"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:visibility="gone" />
                        </LinearLayout>

                        <!-- Option 2: Puerta -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginEnd="6dp"
                                android:contentDescription="puerta"
                                android:src="@drawable/ic_door"
                                app:tint="#444444" />

                            <CheckBox
                                android:id="@+id/cb_puerta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="puerta"
                                android:textColor="#222222"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Option 3: Mosq.Net -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginEnd="6dp"
                                android:contentDescription="mosq.net"
                                android:src="@drawable/ic_mosquito_net"
                                app:tint="#444444" />

                            <CheckBox
                                android:id="@+id/cb_mosq_net"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="mosq.net"
                                android:textColor="#222222"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Posición de las impostas interiores (mm; vacío = reparto igual) -->
                        <LinearLayout
                            android:id="@+id/ll_imp_offsets"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tv_imp_offsets"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="posición de la imposta (mm)"
                                android:textColor="#222222"
                                android:textSize="13sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <EditText android:textColor="#212121" android:textColorHint="#757575"
                                    android:id="@+id/et_imp_off1"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="1ª (mm)"
                                    android:importantForAutofill="no"
                                    android:inputType="number"
                                    android:textSize="14sp" />

                                <EditText android:textColor="#212121" android:textColorHint="#757575"
                                    android:id="@+id/et_imp_off2"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:hint="2ª (mm)"
                                    android:importantForAutofill="no"
                                    android:inputType="number"
                                    android:textSize="14sp" />
                            </LinearLayout>
                        </LinearLayout>

                                        </LinearLayout>

                </LinearLayout>

            </ScrollView>

        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="#999999" />

        <!-- RIGHT PANEL: apertura -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.55"
            android:background="#CCCCCC"
            android:orientation="vertical">

            <!-- Header: apertura -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="#42A5F5"
                android:gravity="center"
                android:text="apertura"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Apertura Grid (3 Columns) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_apertura_mechanisms"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fadeScrollbars="false"
                android:scrollbars="vertical"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="12"
                tools:listitem="@layout/item_icono_config" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Buttons Bar: NO (Blue) / SÍ (Green) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_no"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.45"
            android:backgroundTint="#42A5F5"
            android:text="NO"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_si"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.55"
            android:backgroundTint="#9CCC65"
            android:text="SÍ"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="0dp" />

    </LinearLayout>

</LinearLayout>
