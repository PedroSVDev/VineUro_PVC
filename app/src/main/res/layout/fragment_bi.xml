<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/menu_screen_bg"
    android:fillViewport="true"
    tools:context=".BiFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/tv_bi_estado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp"
            android:textColor="#9CA3AF"
            android:textSize="12sp"
            tools:text="Sincronizando con la nube…" />

        <TextView
            style="@style/BiEtiqueta"
            android:text="@string/bi_periodo" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips_periodo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <TextView
            style="@style/BiEtiqueta"
            android:text="@string/bi_modelo" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips_modelo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tv_bi_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp"
            android:textColor="@color/menu_tile_text"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="12 cotizaciones · 10 con oferta comercial" />

        <!-- ===== LECTURA PARA DECIDIR ===== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/BiTarjeta"
            app:cardBackgroundColor="@color/menu_tile_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/BiEtiqueta"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="0dp"
                    android:text="@string/bi_lectura" />

                <TextView
                    android:id="@+id/tv_bi_lectura"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/menu_tile_text"
                    android:textSize="14sp"
                    tools:text="• Paralela es el modelo que más tarda." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== TPC ===== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/BiTarjeta"
            app:cardBackgroundColor="@color/menu_tile_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/BiEtiqueta"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="0dp"
                    android:text="@string/bi_tpc_titulo" />

                <TextView
                    android:id="@+id/tv_tpc_valor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/menu_nuevo_orden"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    tools:text="12.5 min" />

                <TextView
                    android:id="@+id/tv_tpc_detalle"
                    style="@style/BiDetalle"
                    tools:text="Promedio de 10 cotizaciones" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== NEC ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_nec"
            style="@style/BiTarjeta"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/menu_tile_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/BiEtiqueta"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="0dp"
                    android:text="@string/bi_nec_titulo" />

                <TextView
                    android:id="@+id/tv_nec_valor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/menu_compartir"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    tools:text="0.90" />

                <TextView
                    android:id="@+id/tv_nec_detalle"
                    style="@style/BiDetalle"
                    tools:text="9 de 10 ofertas completas y estandarizadas" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== PDM ===== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/BiTarjeta"
            app:cardBackgroundColor="@color/menu_tile_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/BiEtiqueta"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="0dp"
                    android:text="@string/bi_pdm_titulo" />

                <TextView
                    android:id="@+id/tv_pdm_valor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/menu_precios"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    tools:text="4.2 %" />

                <TextView
                    android:id="@+id/tv_pdm_detalle"
                    style="@style/BiDetalle"
                    tools:text="Desperdicio de 12.6 m sobre 300.0 m de perfil comprado" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== POR MODELO ===== -->
        <TextView
            style="@style/BiEtiqueta"
            android:text="@string/bi_por_modelo" />

        <com.google.android.material.card.MaterialCardView
            style="@style/BiTarjeta"
            app:cardBackgroundColor="@color/menu_tile_bg">

            <LinearLayout
                android:id="@+id/tabla_modelos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== EVOLUCIÓN MENSUAL ===== -->
        <TextView
            style="@style/BiEtiqueta"
            android:text="@string/bi_evolucion" />

        <com.google.android.material.card.MaterialCardView
            style="@style/BiTarjeta"
            app:cardBackgroundColor="@color/menu_tile_bg">

            <LinearLayout
                android:id="@+id/tabla_meses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/BiDetalle"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:text="@string/bi_nota" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
