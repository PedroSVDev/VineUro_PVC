<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#555555"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title Bar -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="Seleccione un Modelo de Ventana (Catálogo 73 Modelos)"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Horizontal Category Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_catalog_categories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_todas"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Todas (73)"
                android:textColor="@color/white" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_estandar"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estándar"
                android:textColor="@color/white" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_puertas"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Puerta-Ventana"
                android:textColor="@color/white" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_fijos"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Con Fijo"
                android:textColor="@color/white" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- 3-Column Grid for All 73 Window Configurations -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_catalog_configs"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="3"
        tools:listitem="@layout/item_window_config" />

    <!-- ACEPTAR Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_aceptar_catalog_config"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#9CCC65"
        android:text="ACEPTAR MODELO"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="8dp" />

</LinearLayout>
