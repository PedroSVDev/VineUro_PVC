            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                <TableLayout android:id="@+id/tableColors" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/white" android:stretchColumns="*">
                    <TableRow android:background="#F0F0F0">
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="color name" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="color" android:gravity="center" android:textStyle="bold" />
