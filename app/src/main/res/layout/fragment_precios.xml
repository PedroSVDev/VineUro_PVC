                <TableLayout android:id="@+id/tableMosquitera" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/white" android:stretchColumns="*">
                    <TableRow android:background="#F0F0F0">
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="sistema de mosq.net" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="red S/ por m2" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="perfil del marco S/ por m" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="sellador de goma S/ por m" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="esquina S/ por la ps" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="poseedor S/ por la ps" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="oído-mango S/ por la ps" android:gravity="center" android:textStyle="bold" />
