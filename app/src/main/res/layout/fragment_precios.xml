<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/menu_screen_bg">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/header_umbral_int"
        android:gravity="center"
        android:padding="8dp"
        android:text="TODOS LOS PRECIOS"
        android:textColor="@color/black"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnConvertir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="#6D5BD0"
        android:text="CONVERTIR PRECIOS"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="@color/menu_nuevo_orden"
        android:text="VOLVER"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/scrollViewPrecios"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- 1. MONEDA -->
            <com.example.vineuro_pvc.views.StrokeTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/header_moneda"
                android:padding="4dp"
                android:text="moneda" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                <TableLayout android:id="@+id/tableMoneda" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/white" android:stretchColumns="*">
                    <TableRow android:background="#F0F0F0">
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="precios moneda" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="tarifa" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="resultados moneda" android:gravity="center" android:textStyle="bold" />
                    </TableRow>
                </TableLayout>
            </HorizontalScrollView>

            <!-- Tipo de cambio oficial BCRP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnActualizarTipoCambio"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Actualizar T.C. BCRP"
                    android:textSize="12sp"
                    app:icon="@android:drawable/ic_popup_sync"
                    app:iconSize="16dp" />

                <TextView
                    android:id="@+id/tvInfoTipoCambio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="US$ y € a soles, fuente oficial BCRP"
                    android:textColor="#666666"
                    android:textSize="12sp" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="16dp" />

            <!-- 2. IMPUESTO -->
            <com.example.vineuro_pvc.views.StrokeTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/header_impuesto"
                android:padding="4dp"
                android:text="el impuesto" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                <TableLayout android:id="@+id/tableImpuesto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/white" android:stretchColumns="*">
                    <TableRow android:background="#F0F0F0">
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="nombre del impuesto" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="impuesto%" android:gravity="center" android:textStyle="bold" />
                    </TableRow>
                </TableLayout>
            </HorizontalScrollView>
            <View android:layout_width="match_parent" android:layout_height="16dp" />

            <!-- 3. PLANES -->
            <com.example.vineuro_pvc.views.StrokeTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/header_planes"
                android:padding="4dp"
                android:text="pestaña planes de financiación" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TableLayout android:id="@+id/tablePlanes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/white" android:stretchColumns="*">
                        <TableRow android:background="#F0F0F0">
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="planes de financiación" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="Descuento total %" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="construcción y materiales margen %" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="trabajos margen %" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="" />
                        </TableRow>
                    </TableLayout>
                </HorizontalScrollView>
                <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end|center_vertical" android:src="@drawable/ic_scroll_arrow" />
            </FrameLayout>
            <ImageButton android:id="@+id/btnAddPlanes" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" android:src="@drawable/ic_menu_add" android:background="@drawable/bg_add_button" />

            <!-- 4. VENTANAS -->
            <com.example.vineuro_pvc.views.StrokeTextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/header_ventanas"
                android:padding="4dp"
                android:text="pestaña sistema de ventanas" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TableLayout android:id="@+id/tableVentanas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/white" android:stretchColumns="*">
                        <TableRow android:background="#F0F0F0">
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="sistema de ventanas" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="marco perfil S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="imposta perfil S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="hoja perfil S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="hoja puerta perfil S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="panel sándwich S/ por m2" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="shtapik (junquillo) S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="caucho sellador S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="glazing bars S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="glazing bars conector S/ por pc" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="refuerzo de marco S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="refuerzo de imposta S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="refuerzo de hoja S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="refuerzo hoja puerta S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="kit oscilobatiente S/ por juego" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="kit oscilante (abatible sup.) S/ por juego" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="kit practicable (giro lateral) S/ por juego" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="kit corredizo horiz. S/ por juego" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="kit corredizo vert. S/ por juego" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="kit francés S/ por juego" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="imposta francesa S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="guías corredizas S/ por juego" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="esquinero de marco S/ por pc" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="esquinero de hoja S/ por pc" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="conector de imposta S/ por pc" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="perfil de asiento S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="dorsill S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="jamba de esquina S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="perfil de junta S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="junta 90° S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="junta 135° S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="perfil de hueco S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="extensor 15 mm S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="extensor 20 mm S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="extensor 40 mm S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="extensor 60 mm S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="extensor 80 mm S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="extensor 100 mm S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="" />
                        </TableRow>
                    </TableLayout>
                </HorizontalScrollView>
                <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end|center_vertical" android:src="@drawable/ic_scroll_arrow" />
            </FrameLayout>
            <ImageButton android:id="@+id/btnAddVentanas" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" android:src="@drawable/ic_menu_add" android:background="@drawable/bg_add_button" />

            <!-- 5. CRISTAL -->
            <com.example.vineuro_pvc.views.StrokeTextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/header_cristal"
                android:padding="4dp"
                android:text="etiqueta del tipo de cristal" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TableLayout android:id="@+id/tableCristal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/white" android:stretchColumns="*">
                        <TableRow android:background="#F0F0F0">
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="tipo de cristal" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="vidrio 1 S/ por m2" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="vidrio 2 S/ por m2" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="vidrio 3 S/ por m2" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="película S/ por m2" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="spaser S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="secadora S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="franja de butilo S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="sellado S/ por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="gas S/ por m2" android:gravity="center" android:textStyle="bold" />
                            <TextView android:textColor="#212121" android:padding="8dp" android:text="" />
                        </TableRow>
                    </TableLayout>
                </HorizontalScrollView>
                <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end|center_vertical" android:src="@drawable/ic_scroll_arrow" />
            </FrameLayout>
            <ImageButton android:id="@+id/btnAddCristal" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" android:src="@drawable/ic_menu_add" android:background="@drawable/bg_add_button" />

            <!-- 6. UMBRAL EXT -->
            <com.example.vineuro_pvc.views.StrokeTextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/header_umbral_ext"
                android:padding="4dp"
                android:text="etiqueta del tipo de umbral externo" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                <TableLayout android:id="@+id/tableUmbralExt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/white" android:stretchColumns="*">
                    <TableRow android:background="#F0F0F0">
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="Tipo de umbral externo" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="el cuerpo exterior del batiente S/ por m" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="de tapón S/ por la ps" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="piezas a comprar (mm x cantidad, ej. 1500x2 800x1; - = a medida)" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="" />
                    </TableRow>
                </TableLayout>
            </HorizontalScrollView>
            <ImageButton android:id="@+id/btnAddUmbralExt" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" android:src="@drawable/ic_menu_add" android:background="@drawable/bg_add_button" />

            <!-- 7. UMBRAL INT -->
            <com.example.vineuro_pvc.views.StrokeTextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/header_umbral_int"
                android:padding="4dp"
                android:text="etiqueta del tipo de descanso interior" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                <TableLayout android:id="@+id/tableUmbralInt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/white" android:stretchColumns="*">
                    <TableRow android:background="#F0F0F0">
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="Tipo de umbral interno" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="cuerpo del peldaño S/ por m" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="de tapón S/ por la ps" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="piezas a comprar (mm x cantidad, ej. 1500x2 800x1; - = a medida)" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="" />
                    </TableRow>
                </TableLayout>
            </HorizontalScrollView>
            <ImageButton android:id="@+id/btnAddUmbralInt" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" android:src="@drawable/ic_menu_add" android:background="@drawable/bg_add_button" />

            <!-- 8. MUEBLES -->
            <com.example.vineuro_pvc.views.StrokeTextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/header_muebles"
                android:padding="4dp"
                android:text="Muebles de ventana" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                <TableLayout android:id="@+id/tableMuebles" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/white" android:stretchColumns="*">
                    <TableRow android:background="#F0F0F0">
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="marca de muebles" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="manejar regulares S/ por la ps" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="manejar con cerradura S/ por la ps" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="manija balcón S/ por la ps" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="" />
                    </TableRow>
                </TableLayout>
            </HorizontalScrollView>
            <ImageButton android:id="@+id/btnAddMuebles" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" android:src="@drawable/ic_menu_add" android:background="@drawable/bg_add_button" />

            <!-- 9. EXTRAS -->
            <com.example.vineuro_pvc.views.StrokeTextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/header_extras"
                android:padding="4dp"
                android:text="pestaña extras" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                <TableLayout android:id="@+id/tableExtras" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/white" android:stretchColumns="*">
                    <TableRow android:background="#F0F0F0">
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="extras establecen" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="precio S/ por:" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="pc" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="m2" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="m" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="m" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="m" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="m" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="" />
                    </TableRow>
                </TableLayout>
            </HorizontalScrollView>
            <ImageButton android:id="@+id/btnAddExtras" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" android:src="@drawable/ic_menu_add" android:background="@drawable/bg_add_button" />

            <!-- 10. EMPLEOS -->
            <com.example.vineuro_pvc.views.StrokeTextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/header_empleos"
                android:padding="4dp"
                android:text="pestaña empleos" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                <TableLayout android:id="@+id/tableEmpleos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/white" android:stretchColumns="*">
                    <TableRow android:background="#F0F0F0">
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="Tipo de empleo" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="precio S/ por:" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="pc" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="m2" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="m" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="m" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="m" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="m" android:gravity="center" android:textStyle="bold" />
                        <TextView android:textColor="#212121" android:padding="8dp" android:text="" />
                    </TableRow>
                </TableLayout>
            </HorizontalScrollView>
            <ImageButton android:id="@+id/btnAddEmpleos" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" android:src="@drawable/ic_menu_add" android:background="@drawable/bg_add_button" />

            <!-- 11. MOSQUITERA -->
