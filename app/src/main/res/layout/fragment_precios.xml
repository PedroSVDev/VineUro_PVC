<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/menu_screen_bg">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/header_umbral_int"
        android:gravity="center"
        android:padding="8dp"
        android:text="TODOS LOS PRECIOS"
        android:textColor="@color/black"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="@color/menu_nuevo_orden"
        android:text="ESPALDA"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/scrollViewPrecios"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- 1. MONEDA -->
            <com.example.vineuro_pvc.views.StrokeTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/header_moneda"
                android:padding="4dp"
                android:text="moneda" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                <TableLayout android:id="@+id/tableMoneda" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/white" android:stretchColumns="*">
                    <TableRow android:background="#F0F0F0">
                        <TextView android:padding="8dp" android:text="precios moneda" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="tarifa" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="resultados moneda" android:gravity="center" android:textStyle="bold" />
                    </TableRow>
                </TableLayout>
            </HorizontalScrollView>
            <View android:layout_width="match_parent" android:layout_height="16dp" />

            <!-- 2. IMPUESTO -->
            <com.example.vineuro_pvc.views.StrokeTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/header_impuesto"
                android:padding="4dp"
                android:text="el impuesto" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                <TableLayout android:id="@+id/tableImpuesto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/white" android:stretchColumns="*">
                    <TableRow android:background="#F0F0F0">
                        <TextView android:padding="8dp" android:text="nombre del impuesto" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="impuesto%" android:gravity="center" android:textStyle="bold" />
                    </TableRow>
                </TableLayout>
            </HorizontalScrollView>
            <View android:layout_width="match_parent" android:layout_height="16dp" />

            <!-- 3. PLANES -->
            <com.example.vineuro_pvc.views.StrokeTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/header_planes"
                android:padding="4dp"
                android:text="pestaña planes de financiación" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TableLayout android:id="@+id/tablePlanes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/white" android:stretchColumns="*">
                        <TableRow android:background="#F0F0F0">
                            <TextView android:padding="8dp" android:text="planes de financiación" android:gravity="center" android:textStyle="bold" />
                            <TextView android:padding="8dp" android:text="Descuento total %" android:gravity="center" android:textStyle="bold" />
                            <TextView android:padding="8dp" android:text="construcción y materiales margen %" android:gravity="center" android:textStyle="bold" />
                            <TextView android:padding="8dp" android:text="trabajos margen %" android:gravity="center" android:textStyle="bold" />
                            <TextView android:padding="8dp" android:text="" />
                        </TableRow>
                    </TableLayout>
                </HorizontalScrollView>
                <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end|center_vertical" android:src="@drawable/ic_scroll_arrow" />
            </FrameLayout>
            <ImageButton android:id="@+id/btnAddPlanes" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" android:src="@drawable/ic_menu_add" android:background="@drawable/bg_add_button" />

            <!-- 4. VENTANAS -->
            <com.example.vineuro_pvc.views.StrokeTextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/header_ventanas"
                android:padding="4dp"
                android:text="pestaña sistema de ventanas" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TableLayout android:id="@+id/tableVentanas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/white" android:stretchColumns="*">
                        <TableRow android:background="#F0F0F0">
                            <TextView android:padding="8dp" android:text="sistema de ventanas" android:gravity="center" android:textStyle="bold" />
                            <TextView android:padding="8dp" android:text="marco perfil € por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:padding="8dp" android:text="impuesto perfil € por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:padding="8dp" android:text="hoja perfil € por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:padding="8dp" android:text="hoja dor perfil € por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:padding="8dp" android:text="emparedado panel € por m2" android:gravity="center" android:textStyle="bold" />
                            <TextView android:padding="8dp" android:text="glazing beads € por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:padding="8dp" android:text="caucho sellador € por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:padding="8dp" android:text="glazing bars € per m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:padding="8dp" android:text="glazing bars connector € per pc" android:gravity="center" android:textStyle="bold" />
                            <TextView android:padding="8dp" android:text="" />
                        </TableRow>
                    </TableLayout>
                </HorizontalScrollView>
                <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end|center_vertical" android:src="@drawable/ic_scroll_arrow" />
            </FrameLayout>
            <ImageButton android:id="@+id/btnAddVentanas" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" android:src="@drawable/ic_menu_add" android:background="@drawable/bg_add_button" />

            <!-- 5. CRISTAL -->
            <com.example.vineuro_pvc.views.StrokeTextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/header_cristal"
                android:padding="4dp"
                android:text="etiqueta del tipo de cristal" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TableLayout android:id="@+id/tableCristal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/white" android:stretchColumns="*">
                        <TableRow android:background="#F0F0F0">
                            <TextView android:padding="8dp" android:text="tipo de cristal" android:gravity="center" android:textStyle="bold" />
                            <TextView android:padding="8dp" android:text="vidrio 1 € por m2" android:gravity="center" android:textStyle="bold" />
                            <TextView android:padding="8dp" android:text="vidrio 2 € por m2" android:gravity="center" android:textStyle="bold" />
                            <TextView android:padding="8dp" android:text="vidrio 3 € por m2" android:gravity="center" android:textStyle="bold" />
                            <TextView android:padding="8dp" android:text="película € por m2" android:gravity="center" android:textStyle="bold" />
                            <TextView android:padding="8dp" android:text="spaser € por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:padding="8dp" android:text="secadora € por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:padding="8dp" android:text="franja de butilo € por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:padding="8dp" android:text="sellado € por m" android:gravity="center" android:textStyle="bold" />
                            <TextView android:padding="8dp" android:text="gas € por m2" android:gravity="center" android:textStyle="bold" />
                            <TextView android:padding="8dp" android:text="" />
                        </TableRow>
                    </TableLayout>
                </HorizontalScrollView>
                <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end|center_vertical" android:src="@drawable/ic_scroll_arrow" />
            </FrameLayout>
            <ImageButton android:id="@+id/btnAddCristal" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" android:src="@drawable/ic_menu_add" android:background="@drawable/bg_add_button" />

            <!-- 6. UMBRAL EXT -->
            <com.example.vineuro_pvc.views.StrokeTextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/header_umbral_ext"
                android:padding="4dp"
                android:text="etiqueta del tipo de umbral externo" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                <TableLayout android:id="@+id/tableUmbralExt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/white" android:stretchColumns="*">
                    <TableRow android:background="#F0F0F0">
                        <TextView android:padding="8dp" android:text="Tipo de umbral externo" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="el cuerpo exterior del batiente € por m" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="de tapón € por la ps" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="" />
                    </TableRow>
                </TableLayout>
            </HorizontalScrollView>
            <ImageButton android:id="@+id/btnAddUmbralExt" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" android:src="@drawable/ic_menu_add" android:background="@drawable/bg_add_button" />

            <!-- 7. UMBRAL INT -->
            <com.example.vineuro_pvc.views.StrokeTextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/header_umbral_int"
                android:padding="4dp"
                android:text="etiqueta del tipo de descanso interior" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                <TableLayout android:id="@+id/tableUmbralInt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/white" android:stretchColumns="*">
                    <TableRow android:background="#F0F0F0">
                        <TextView android:padding="8dp" android:text="Tipo de umbral interno" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="cuerpo del peldaño € por m" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="de tapón € por la ps" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="" />
                    </TableRow>
                </TableLayout>
            </HorizontalScrollView>
            <ImageButton android:id="@+id/btnAddUmbralInt" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" android:src="@drawable/ic_menu_add" android:background="@drawable/bg_add_button" />

            <!-- 8. MUEBLES -->
            <com.example.vineuro_pvc.views.StrokeTextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/header_muebles"
                android:padding="4dp"
                android:text="Muebles de ventana" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                <TableLayout android:id="@+id/tableMuebles" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/white" android:stretchColumns="*">
                    <TableRow android:background="#F0F0F0">
                        <TextView android:padding="8dp" android:text="marca de muebles" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="manejar regulares € por la ps" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="manejar con cerradura € por la ps" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="manija balcón € por la ps" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="" />
                    </TableRow>
                </TableLayout>
            </HorizontalScrollView>
            <ImageButton android:id="@+id/btnAddMuebles" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" android:src="@drawable/ic_menu_add" android:background="@drawable/bg_add_button" />

            <!-- 9. EXTRAS -->
            <com.example.vineuro_pvc.views.StrokeTextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/header_extras"
                android:padding="4dp"
                android:text="pestaña extras" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                <TableLayout android:id="@+id/tableExtras" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/white" android:stretchColumns="*">
                    <TableRow android:background="#F0F0F0">
                        <TextView android:padding="8dp" android:text="extras establecen" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="precio € por:" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="pc" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="m2" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="m" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="m" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="m" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="m" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="" />
                    </TableRow>
                </TableLayout>
            </HorizontalScrollView>
            <ImageButton android:id="@+id/btnAddExtras" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" android:src="@drawable/ic_menu_add" android:background="@drawable/bg_add_button" />

            <!-- 10. EMPLEOS -->
            <com.example.vineuro_pvc.views.StrokeTextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/header_empleos"
                android:padding="4dp"
                android:text="pestaña empleos" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                <TableLayout android:id="@+id/tableEmpleos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/white" android:stretchColumns="*">
                    <TableRow android:background="#F0F0F0">
                        <TextView android:padding="8dp" android:text="Tipo de empleo" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="precio € por:" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="pc" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="m2" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="m" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="m" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="m" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="m" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="" />
                    </TableRow>
                </TableLayout>
            </HorizontalScrollView>
            <ImageButton android:id="@+id/btnAddEmpleos" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" android:src="@drawable/ic_menu_add" android:background="@drawable/bg_add_button" />

            <!-- 11. MOSQUITERA -->
            <com.example.vineuro_pvc.views.StrokeTextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/header_mosquitera"
                android:padding="4dp"
                android:text="pestaña mosquitera" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                <TableLayout android:id="@+id/tableMosquitera" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/white" android:stretchColumns="*">
                    <TableRow android:background="#F0F0F0">
                        <TextView android:padding="8dp" android:text="sistema de mosq.net" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="red € por m2" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="perfil del marco € por m" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="sellador de goma € por m" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="esquina € por la ps" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="poseedor € por la ps" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="oído-mango € por la ps" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="" />
                    </TableRow>
                </TableLayout>
            </HorizontalScrollView>
            <ImageButton android:id="@+id/btnAddMosquitera" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" android:src="@drawable/ic_menu_add" android:background="@drawable/bg_add_button" />

            <!-- 12. LAMINACIÓN -->
            <com.example.vineuro_pvc.views.StrokeTextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/header_laminacion"
                android:padding="4dp"
                android:text="pestaña de laminación" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                <TableLayout android:id="@+id/tableLaminacion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/white" android:stretchColumns="*">
                    <TableRow android:background="#F0F0F0">
                        <TextView android:padding="8dp" android:text="tipo de laminación" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="laminación € por m2" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="" />
                    </TableRow>
                </TableLayout>
            </HorizontalScrollView>
            <ImageButton android:id="@+id/btnAddLaminacion" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" android:src="@drawable/ic_menu_add" android:background="@drawable/bg_add_button" />

            <!-- 13. COLORES -->
            <com.example.vineuro_pvc.views.StrokeTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/header_colors"
                android:padding="4dp"
                android:text="colors" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                <TableLayout android:id="@+id/tableColors" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/white" android:stretchColumns="*">
                    <TableRow android:background="#F0F0F0">
                        <TextView android:padding="8dp" android:text="color name" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="color" android:gravity="center" android:textStyle="bold" />
                        <TextView android:padding="8dp" android:text="" />
                    </TableRow>
                </TableLayout>
            </HorizontalScrollView>
            <ImageButton android:id="@+id/btnAddColors" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="8dp" android:src="@drawable/ic_menu_add" android:background="@drawable/bg_add_button" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
