<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de un cliente en "Pedidos guardados": al tocarla se despliegan sus pedidos -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_grupo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="2dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_circle_solid"
            android:backgroundTint="@color/brand_dark">

            <TextView
                android:id="@+id/tv_iniciales_grupo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="JC" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_nombre_grupo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textColor="#1F2937"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Jorge Carbajal" />

            <TextView
                android:id="@+id/tv_detalle_grupo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#6B7280"
                android:textSize="13sp"
                tools:text="CLI-0003 · 2 pedidos · último 13/10/2026 10:20" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_cantidad_grupo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_solid"
            android:backgroundTint="#E5E7EB"
            android:gravity="center"
            android:minWidth="28dp"
            android:minHeight="28dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="#1F2937"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="2" />

        <ImageView
            android:id="@+id/iv_flecha_grupo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:importantForAccessibility="no"
            android:rotation="90"
            android:src="@drawable/ic_chevron_right"
            app:tint="#6B7280" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
