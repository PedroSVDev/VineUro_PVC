<?xml version="1.0" encoding="utf-8"?>
<!--
  Los datos de clientes (Ley N.° 29733) no se incluyen en copias de seguridad de Google ni en la
  transferencia entre dispositivos; la copia de respaldo oficial es la base de datos en Supabase.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
